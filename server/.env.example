PORT=8080
NODE_ENV=development
CLIENT_URL=http://localhost:5173/mg69-street-luxury,https://mohan143-web.github.io/mg69-street-luxury

# --- Database (optional) ---
# When unset, the API runs on an in-memory store so everything works with zero setup.
# When set, users / orders / products persist to MongoDB Atlas.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/mg69
ALLOW_RESEED=false

# --- Stripe (optional) ---
# When unset, checkout endpoints return 503 and the storefront falls back to a local order draft.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# --- Auth ---
# Secret used to sign JWTs. CHANGE THIS in production to a long random string.
JWT_SECRET=dev-mg69-change-me
# Token lifetime (e.g. 7d, 24h, 60m).
JWT_EXPIRES_IN=7d
# A first admin account is ensured on startup using these credentials.
ADMIN_EMAIL=admin@mg69.com
ADMIN_PASSWORD=mg69admin
ADMIN_NAME=MG69 Admin
